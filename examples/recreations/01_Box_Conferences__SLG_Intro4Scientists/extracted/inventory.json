          "prst": "rect",
          "flipH": null,
          "flipV": null,
          "text": "Reason is this ability to bring together the faculties of logic with the faculties of an intuitive, implicit, embodied understanding of what it means to be alive\u201d \u2013Iain McGilchrist"
        },
        {
          "type": "sp",
          "id": 10,
          "name": "TextBox 9",
          "x": 0,
